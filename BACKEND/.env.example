# Copy this file to .env and fill in the values. Never commit .env.

# MongoDB Atlas connection string (Atlas > Database > Connect > Drivers).
# Put the database name before the "?", e.g. ...mongodb.net/appointment_sys?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/appointment_sys?retryWrites=true&w=majority

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1d

PORT=5000
NODE_ENV=development

# Frontend URL(s) allowed to call the API (comma-separated, no trailing slash).
CLIENT_URL=http://localhost:5173

# Timezone that decides what "today" and "past" mean for bookings.
APP_TIMEZONE=Asia/Manila

# Brevo (email OTP). API key: Brevo > SMTP & API > API Keys.
# The sender must be verified in Brevo > Senders, Domains & Dedicated IPs.
# If BREVO_API_KEY is empty in development, OTP codes are printed to the server console instead.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=you@example.com
BREVO_SENDER_NAME=BookEase
APP_NAME=BookEase

# Admin account created by `npm run seed` (change the password before deploying).
SEED_ADMIN_EMAIL=admin@appointments.test
SEED_ADMIN_PASSWORD=Admin12345
